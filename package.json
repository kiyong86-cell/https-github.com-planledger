{
  "name": "bizplan-receipt-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:offline": "node offline/build.mjs",
    "check:convert": "esbuild offline/check.ts --bundle --platform=node --format=esm --external:node:* --outfile=node_modules/.cache/check.mjs --log-level=error && node node_modules/.cache/check.mjs",
    "inspect:docx": "esbuild offline/inspect.ts --bundle --platform=node --format=esm --alias:mammoth=mammoth/mammoth.browser.js --external:node:* --outfile=node_modules/.cache/inspect.mjs --log-level=error && node node_modules/.cache/inspect.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "docx": "^9.0.2",
    "hwp-convert": "^1.11.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2"
  }
}
