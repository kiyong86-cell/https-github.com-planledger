# ── 클라우드 모드 설정 (웹 서비스로 운영할 때만 필요) ──
# 이 두 값을 채우면 앱이 자동으로 "로그인 + 클라우드 저장" 모드로 바뀝니다.
# 비워두면(파일이 없으면) 지금처럼 이 컴퓨터에만 저장하는 로컬 모드로 동작합니다.
#
# https://supabase.com 프로젝트 → Settings → API 에서 복사:
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── 후원 정보 — 후원 페이지(/support)에 표시됨 ──
# 후원 계좌를 입력하세요. (비워두면 "설정 안 됨"으로 표시)
NEXT_PUBLIC_BANK_NAME=국민은행
NEXT_PUBLIC_BANK_ACCOUNT=000000-00-000000
NEXT_PUBLIC_BANK_HOLDER=박기용
# (선택) 토스/카카오페이 송금 링크를 넣으면 "간편 송금" 버튼이 생깁니다
NEXT_PUBLIC_DONATE_LINK=

# ── 제작자 전용 통계 페이지(/admin) 접근용 ──
# 통계를 볼 관리자(본인) 로그인 이메일. 이 이메일로 로그인해야 /admin이 열립니다.
NEXT_PUBLIC_ADMIN_EMAIL=kiyong0263@naver.com

# ── 학교 전용 구역(/school, KAIROS) ──
# 따로 넣을 값이 없습니다. 위의 NEXT_PUBLIC_ADMIN_EMAIL 이 KAIROS 관리자(승인 담당)가 됩니다.
# 같은 이메일을 supabase/kairos.sql 의 kairos_admin_email() 함수에도 적어주세요.
